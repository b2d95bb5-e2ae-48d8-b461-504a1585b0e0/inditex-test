{
  "info": {
    "name": "Similar Products E2E",
    "_postman_id": "e2e-similar-products-collection",
    "description": "End-to-end tests for similarproducts service using simulado mocks.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get similar products - normal (product 1)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/product/1/similar",
          "host": ["{{baseUrl}}"],
          "path": ["product", "1", "similar"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "let json = pm.response.json();",
              "pm.test('Response is an array', function () { pm.expect(json).to.be.an('array'); });",
              "pm.test('Each product contains required fields', function () {",
              "  json.forEach(p => {",
              "    pm.expect(p).to.have.property('id');",
              "    pm.expect(p).to.have.property('name');",
              "    pm.expect(p).to.have.property('price');",
              "    pm.expect(p).to.have.property('availability');",
              "  });",
              "});"
            ]
          }
        }
      ]
    },
